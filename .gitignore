# 依赖及 Electron / Vite 构建、安装包产物，可通过 pnpm 重新生成。
node_modules/
# pnpm 在当前项目生成的本地包缓存，不属于源码或锁文件。
.pnpm-store/
out/
dist/

# 本地开发日志、TypeScript 增量缓存及测试报告。
*.log
*.tsbuildinfo
coverage/
.vitest/
# 包含发布启动检查的合成用户数据、截图和诊断结果，可由检查脚本重新生成。
test-results/
playwright-report/

# 机器相关的编辑器、系统缓存及临时文件（包括曾被跟踪的 IDE 工程配置）。
/.idea/
.DS_Store
Thumbs.db
*.tmp
*.swp

# 本地环境配置可能包含密钥；允许提交不含真实凭据的示例。
.env
.env.*
!.env.example
!.env.*.example

# FFmpeg 下载产物，由 pnpm ffmpeg:prepare 准备，不将可执行文件入库。
resources/ffmpeg/ffmpeg.exe

# 私人设计文档与本地调试资料；根目录的开发指南与更新日志正常提交。
/my_doc/*

# 用户导出的聊天截图可能含私人信息，不提交默认命名的输出目录。
/滚动长截图/
